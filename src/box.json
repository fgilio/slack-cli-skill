{
  "chmod": "0755",
  "directories": [
    "app",
    "bootstrap",
    "config",
    "vendor"
  ],
  "files": [
    "composer.json"
  ],
  "exclude-composer-files": false,
  "compression": "GZ",
  "compactors": [
    "KevinGH\\Box\\Compactor\\Php",
    "KevinGH\\Box\\Compactor\\Json"
  ],
  "exclude-dev-files": true,
  "force-autodiscovery": true,
  "main": "slack-cli",
  "output": "builds/slack-cli.phar",
  "check-requirements": false
}
